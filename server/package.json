{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "description": "FinTrack REST API (Express + TypeScript).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test-data:export": "tsx scripts/export-test-data.ts",
    "test-data:pdf": "tsx scripts/export-pdf-fixtures.ts",
    "test-data:banks": "tsx scripts/export-bank-fixtures.ts",
    "rules:apply": "tsx scripts/apply-rules.ts",
    "eval:categorize": "tsx scripts/eval-categorize.ts",
    "llm:apply": "tsx scripts/apply-llm.ts",
    "anomalies:detect": "tsx scripts/detect-anomalies.ts",
    "summary:month": "tsx scripts/summarize-month.ts",
    "accuracy:report": "tsx scripts/accuracy-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "pdfkit": "^0.20.2",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
