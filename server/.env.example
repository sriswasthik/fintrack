# Postgres connection string used by Prisma (Phase 1 onwards).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintrack?schema=public

# Anthropic API key — server-side only, never exposed to the client bundle.
ANTHROPIC_API_KEY=

# JWT signing secrets. Generate your own, e.g. `openssl rand -base64 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Set to "off" to keep merchant names on this server: unresolved merchants then
# go straight to the review queue instead of being sent to the model. Payments
# to individuals are never sent either way. The monthly summary, which only
# ever sees computed totals, is unaffected.
AI_CATEGORIZATION=on

# A PDF whose layout no built-in reader recognises is transcribed by the model.
# Only the transaction rows are sent, with account numbers, PAN, Aadhaar and
# email addresses masked; the name, address and account details above the table
# are never sent. Set to "off" to refuse such a PDF instead.
AI_STATEMENT_READER=on

# Google Sign-In (Phase 16). The OAuth 2.0 Web application client ID from the
# Google Cloud console (APIs & Services -> Credentials). The server checks that
# every ID token it is given was issued for exactly this client, so it must be
# the same value the client is built with as VITE_GOOGLE_CLIENT_ID.
#
# There is no client *secret* here, and there should not be: the browser runs
# the flow and hands us an ID token, which is verified against Google's public
# keys. Leave this unset to turn Google sign-in off — the buttons disappear and
# email/password carries on unchanged.
GOOGLE_CLIENT_ID=

# Transactional email (Phase 17). Provider is Resend: the whole integration is
# an API key and an HTTPS call, with no SMTP connection pool to manage. The key
# comes from resend.com -> API Keys; EMAIL_FROM must be an address on a domain
# verified there, e.g. "FinTrack <hello@yourdomain.com>".
#
# Leave both unset and registration still works: the welcome email is skipped
# and the reason is logged. Password reset needs them, though — in production,
# "forgot password" then answers that reset is unavailable, and the server warns
# at startup. Locally, the reset link is printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM=

# Where the app lives, for links inside an email. Falls back to CORS_ORIGIN,
# which a working deployment has already set to the client's URL, so this is
# only needed when the two genuinely differ.
APP_URL=

# Origin allowed by CORS (the Vite dev server in local development).
CORS_ORIGIN=http://localhost:5173

# How many proxies in front of the server to believe about the client's IP,
# which is what the rate limiters key a signed-out request by. Leave unset: it
# is 1 in production (Render and Railway each put one load balancer in front)
# and off otherwise. Set "false" for a production server reached directly.
TRUST_PROXY=

# Port the Express server listens on. Hosting platforms usually set this
# themselves; leave it alone there.
PORT=4000

# No-signup demo mode. When "on", POST /api/auth/demo hands anonymous visitors
# a read-only session on the account below — which must be loaded first with
# `npm run demo:seed --workspace server`. Leave it unset on any instance
# holding real data.
DEMO_MODE=off
DEMO_USER_EMAIL=demo@fintrack.local
