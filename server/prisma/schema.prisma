// FinTrack data model — implements PROJECT_CONTEXT.md §6 (entities) and §5 (taxonomy).
//
// Conventions used throughout:
//   * Money is `Decimal(12, 2)`, never a float.
//   * `Transaction.amount` is debit-positive: a positive amount is money leaving
//     the account (a purchase), a negative amount is money arriving (income,
//     refunds, incoming transfers). This is what makes a refund "a negative
//     amount" as described in PROJECT_CONTEXT.md §8 case 2.
//   * A transaction with a null `postedDate` is still pending (§8 case 6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts as of Prisma 7.
}

/// The fixed spending taxonomy from PROJECT_CONTEXT.md §5. Categorization must
/// always resolve to one of these — never a free-form string.
enum Category {
  GROCERIES
  DINING
  TRANSPORTATION
  HOUSING
  UTILITIES
  SUBSCRIPTIONS
  ENTERTAINMENT
  SHOPPING
  HEALTH_FITNESS
  TRAVEL
  INCOME
  TRANSFER
  FEES_INTEREST
  INSURANCE
  /// Repayment of borrowed money: an EMI instalment, a personal or vehicle
  /// loan, a credit-card EMI conversion. Distinct from FEES_INTEREST, which is
  /// what a bank charges you, and from TRANSFER, which moves your own money.
  EMI_LOAN
  /// Money put away rather than spent: an SIP, a broker transfer, a mutual-fund
  /// purchase. It leaves the account like spending does, so it is a category
  /// rather than an exclusion — see docs/EDGE_CASES.md.
  INVESTMENTS
  /// Cash taken out at an ATM or over the counter. The money is not yet spent
  /// on anything in particular; this category is where it waits.
  CASH_WITHDRAWAL
  EDUCATION
  PERSONAL_CARE
  GIFTS_DONATIONS
  BUSINESS
  REFUND
  UNCATEGORIZED
}

/// How a transaction's category was decided. MANUAL always wins and is never
/// overwritten by a later rule or LLM pass (PROJECT_CONTEXT.md §7).
enum TransactionSource {
  RULE
  LLM
  MANUAL
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

/// The anomaly classes detected in Phase 6.
enum AnomalyType {
  UNUSUAL_AMOUNT
  NEW_RECURRING_CHARGE
  SUBSCRIPTION_PRICE_INCREASE
  CATEGORY_SPEND_SPIKE
  POSSIBLE_DUPLICATE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id    String @id @default(cuid())
  email String @unique

  /// Null for an account that has only ever signed in with Google (Phase 16).
  /// The brief calls for creating such a user "with no password set", so this
  /// had to stop being required — which makes every password comparison a
  /// place that must handle its absence rather than assume a string.
  passwordHash String?

  /// Google's `sub` claim: stable for the life of the Google account, and the
  /// thing an account is matched on first. Unique, so two FinTrack users can
  /// never claim the same Google identity.
  googleId String? @unique

  /// Avatar URL from the Google profile. Nullable and purely cosmetic — it is
  /// whatever Google last told us, not something the user set here.
  picture String?

  name String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  rules             Rule[]
  refreshTokens     RefreshToken[]
  anomalyFlags      AnomalyFlag[]
  monthlySummaries  MonthlySummary[]
  categoryOverrides CategoryOverride[]
  payees            Payee[]
  importBatches     ImportBatch[]
  budgets           Budget[]
  passwordResets    PasswordResetToken[]
}

/// Long-lived refresh tokens, stored hashed. Issued in Phase 9.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A single-use link for setting a new password, emailed on request (Phase 20).
///
/// Stored hashed, exactly like a refresh token: the table is something a
/// backup or a read replica can leak, and a leaked row must not be a working
/// link. Short-lived, and spent the moment it is used.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  type AccountType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  importBatches ImportBatch[]

  @@unique([userId, name])
  @@index([userId])
}

/// One confirmed import: the rows a single Confirm Import inserted (Phase 20).
///
/// It exists so an import can be undone as a unit. Without it the rows of a
/// wrong statement — the wrong account chosen, the wrong month uploaded — are
/// indistinguishable from the rest and can only be removed one at a time.
model ImportBatch {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// The files as they were uploaded, so a person can recognise the import.
  fileNames String[]
  /// Rows inserted by the commit. Fixed at the time: the rows themselves can
  /// go later, with their account.
  rowCount  Int

  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([accountId])
}

model Transaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Date the transaction occurred.
  date       DateTime
  /// Date it cleared. Null means the transaction is still pending (§8 case 6).
  postedDate DateTime?

  /// The raw description line as it appeared in the bank export.
  description        String
  /// The merchant substring lifted out of the description, still messy
  /// (e.g. "SQ *JOES COFFEE", "TST* THE HALL", "PAYPAL *STEAMGAMES").
  rawMerchant        String
  /// The cleaned merchant key used for rule matching and LLM caching (§8 case 8).
  normalizedMerchant String

  /// The other party exactly as the source named them — the "Paid to"/"Received
  /// from" name on a UPI-app export, or the narration on a bank statement.
  /// Kept raw and separate from `rawMerchant`, which the normalizer has already
  /// had its way with: a person's name is not a merchant, and squashing the two
  /// loses the only record of who the money actually went to.
  counterpartyRaw String?

  /// The UPI virtual payment address (`name@bank`), when the source carried one.
  /// Only UPI-app exports do; a bank statement almost never prints it.
  upiVpa String?

  /// Debit-positive: purchases are positive, refunds and income are negative.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  category   Category          @default(UNCATEGORIZED)
  /// 0–1. Rule matches are 1.0; LLM answers carry the model's own score.
  confidence Float             @default(0)
  source     TransactionSource @default(RULE)

  /// Set on a row that looks like a sync-glitch duplicate of an earlier one (§8 case 5).
  isDuplicateOf String?
  duplicateOf   Transaction?  @relation("TransactionDuplicates", fields: [isDuplicateOf], references: [id], onDelete: SetNull)
  duplicates    Transaction[] @relation("TransactionDuplicates")

  /// Set on the *original purchase*, pointing at the refund that offsets it (§8 case 2).
  /// From the refund row, the reverse side of the relation is `refundFor`.
  linkedRefundId String?      @unique
  linkedRefund   Transaction? @relation("PurchaseRefund", fields: [linkedRefundId], references: [id], onDelete: SetNull)
  refundFor      Transaction? @relation("PurchaseRefund")

  /// Set on the *outgoing* leg of a transfer between two of the user's own
  /// accounts, pointing at the incoming leg (§8 case 1). From the incoming row,
  /// the reverse side of the relation is `transferPairOf`. Both legs are
  /// categorized TRANSFER and excluded from spend and income totals (§5).
  transferPairId String?      @unique
  transferPair   Transaction? @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf Transaction? @relation("TransferPair")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The other party, resolved to a running ledger entry (Phase 15). Null until
  /// resolution has run, and null forever for a line with no counterparty worth
  /// keeping — a bank fee, an ATM withdrawal.
  payeeId String?
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: SetNull)

  /// The import that brought the row in (Phase 20). Null for rows loaded by
  /// the seed scripts, which were never imported and so cannot be un-imported.
  /// Cascade, because undoing an import is deleting its batch.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  splits       Split[]
  anomalyFlags AnomalyFlag[]
  overrides    CategoryOverride[]

  @@index([accountId, date])
  @@index([normalizedMerchant])
  @@index([category])
  @@index([date])
  @@index([importBatchId])
}

/// A single charge divided across categories, e.g. a big-box order mixing
/// groceries and electronics (§8 case 3). Split amounts sum to the parent amount.
model Split {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  category Category
  amount   Decimal  @db.Decimal(12, 2)
  note     String?

  createdAt DateTime @default(now())

  @@index([transactionId])
}

/// Deterministic categorization rules. A null `userId` is a built-in rule that
/// applies to everyone; a non-null one was learned from that user's override.
/// Every time a person overrides a category, recorded before the change is made.
///
/// The rule engine and the LLM both write categories; a person writing one is
/// the only signal that says the automatic answer was wrong. Keeping the old
/// value alongside the new one is what makes that measurable — "how often is
/// the engine corrected, and on what" is a question about this table.
model CategoryOverride {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// The merchant key at the time of the override, so the record survives a
  /// later re-normalization of the transaction.
  merchant String

  fromCategory Category
  toCategory   Category
  /// Whether the correction also taught a rule for the merchant.
  learnedRule  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
}

model Rule {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pattern             String
  category            Category
  /// Lower numbers win. Learned overrides are seeded below the built-ins.
  priority            Int      @default(100)
  learnedFromOverride Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pattern])
}

/// Whether a payee is a human being or a business.
///
/// Phase 14's classifier answers PERSON, BUSINESS *or* UNKNOWN, and UNKNOWN is
/// its commonest honest answer on an ALL-CAPS bank narration. This enum has no
/// UNKNOWN because the Phase 15 brief specifies two values, so an unclassified
/// payee is stored BUSINESS — see `services/payees/resolve.ts`, which is the
/// one place that collapse happens.
enum PayeeType {
  PERSON
  BUSINESS
}

/// A counterparty the user has transacted with more than once.
///
/// The point of the model is the *running total*: "how much have I paid Ramesh
/// and how much has he paid me" is a question about a person across months, and
/// a transaction list sorted by date can never answer it. Aggregates are
/// deliberately NOT stored here — they are computed per request from the
/// transactions, so they can never disagree with the rows they summarise.
model Payee {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The name as a person should read it: the counterparty a UPI export named,
  /// or the name lifted out of a narration, with any `@bank` suffix stripped.
  displayName String

  /// The UPI address, when one has ever been seen for this payee. The strongest
  /// identity there is — two people are called Ramesh Kumar, but
  /// `rameshkumar@ybl` is one account — so it is matched on before the name.
  upiVpa String?

  /// The mobile number, when the UPI handle was one.
  phone String?

  type PayeeType

  createdAt DateTime @default(now())

  transactions Transaction[]

  /// One payee per address per user. Partial by nature: Postgres treats NULLs as
  /// distinct, so the many payees with no address never collide with each other.
  @@unique([userId, upiVpa])
  @@index([userId])
  /// Name matching is scoped to the user and case-insensitive, so the lookup is
  /// on the lower-cased name; Postgres needs the expression index to use it.
  @@index([userId, displayName])
}

/// Memoizes every LLM categorization decision so the same merchant is never
/// sent to the model twice (PROJECT_CONTEXT.md §7).
model MerchantCategoryCache {
  normalizedMerchant String   @id
  category           Category
  confidence         Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
}

model AnomalyFlag {
  id String @id @default(cuid())

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AnomalyType
  severity    AnomalySeverity
  /// Calendar month the flag belongs to, as "YYYY-MM".
  month       String
  explanation String

  /// Stable identity for the underlying finding, e.g. "UNUSUAL_AMOUNT:<txn id>".
  /// Detection is idempotent: re-running it upserts on this rather than
  /// producing a second copy of a flag the user has already seen.
  fingerprint String

  /// Set when the user dismisses the flag. Dismissals are kept rather than
  /// deleted so a later detection pass cannot resurrect them.
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, month])
  @@index([transactionId])
  @@index([type])
}

/// A monthly spending limit for one category (Phase 20).
///
/// Spend against it is computed per request by the dashboard aggregation —
/// transfers excluded, refunds netted, splits counted by part — rather than
/// stored, for the same reason the payee ledger computes its totals: a stored
/// figure is one import away from disagreeing with the rows.
model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category Category
  /// Rupees per calendar month. Always positive.
  amount   Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model MonthlySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM".
  month         String
  content       String
  /// The pre-computed aggregates the summary was generated from, wrapped with a
  /// note of how it was produced: `{ stats, generation }`. Kept so the text can
  /// be checked against the numbers it claims (PROJECT_CONTEXT.md §7), and so a
  /// later import that moves those numbers can be spotted as stale.
  statsSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}
