// FinTrack data model — implements PROJECT_CONTEXT.md §6 (entities) and §5 (taxonomy).
//
// Conventions used throughout:
//   * Money is `Decimal(12, 2)`, never a float.
//   * `Transaction.amount` is debit-positive: a positive amount is money leaving
//     the account (a purchase), a negative amount is money arriving (income,
//     refunds, incoming transfers). This is what makes a refund "a negative
//     amount" as described in PROJECT_CONTEXT.md §8 case 2.
//   * A transaction with a null `postedDate` is still pending (§8 case 6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts as of Prisma 7.
}

/// The fixed spending taxonomy from PROJECT_CONTEXT.md §5. Categorization must
/// always resolve to one of these — never a free-form string.
enum Category {
  GROCERIES
  DINING
  TRANSPORTATION
  HOUSING
  UTILITIES
  SUBSCRIPTIONS
  ENTERTAINMENT
  SHOPPING
  HEALTH_FITNESS
  TRAVEL
  INCOME
  TRANSFER
  FEES_INTEREST
  INSURANCE
  EDUCATION
  PERSONAL_CARE
  GIFTS_DONATIONS
  BUSINESS
  REFUND
  UNCATEGORIZED
}

/// How a transaction's category was decided. MANUAL always wins and is never
/// overwritten by a later rule or LLM pass (PROJECT_CONTEXT.md §7).
enum TransactionSource {
  RULE
  LLM
  MANUAL
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

/// The anomaly classes detected in Phase 6.
enum AnomalyType {
  UNUSUAL_AMOUNT
  NEW_RECURRING_CHARGE
  SUBSCRIPTION_PRICE_INCREASE
  CATEGORY_SPEND_SPIKE
  POSSIBLE_DUPLICATE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  rules            Rule[]
  refreshTokens    RefreshToken[]
  anomalyFlags     AnomalyFlag[]
  monthlySummaries MonthlySummary[]
  categoryOverrides CategoryOverride[]
}

/// Long-lived refresh tokens, stored hashed. Issued in Phase 9.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  type AccountType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Date the transaction occurred.
  date DateTime
  /// Date it cleared. Null means the transaction is still pending (§8 case 6).
  postedDate DateTime?

  /// The raw description line as it appeared in the bank export.
  description String
  /// The merchant substring lifted out of the description, still messy
  /// (e.g. "SQ *JOES COFFEE", "TST* THE HALL", "PAYPAL *STEAMGAMES").
  rawMerchant String
  /// The cleaned merchant key used for rule matching and LLM caching (§8 case 8).
  normalizedMerchant String

  /// The other party exactly as the source named them — the "Paid to"/"Received
  /// from" name on a UPI-app export, or the narration on a bank statement.
  /// Kept raw and separate from `rawMerchant`, which the normalizer has already
  /// had its way with: a person's name is not a merchant, and squashing the two
  /// loses the only record of who the money actually went to.
  counterpartyRaw String?

  /// The UPI virtual payment address (`name@bank`), when the source carried one.
  /// Only UPI-app exports do; a bank statement almost never prints it.
  upiVpa String?

  /// Debit-positive: purchases are positive, refunds and income are negative.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  category   Category          @default(UNCATEGORIZED)
  /// 0–1. Rule matches are 1.0; LLM answers carry the model's own score.
  confidence Float             @default(0)
  source     TransactionSource @default(RULE)

  /// Set on a row that looks like a sync-glitch duplicate of an earlier one (§8 case 5).
  isDuplicateOf String?
  duplicateOf   Transaction?  @relation("TransactionDuplicates", fields: [isDuplicateOf], references: [id], onDelete: SetNull)
  duplicates    Transaction[] @relation("TransactionDuplicates")

  /// Set on the *original purchase*, pointing at the refund that offsets it (§8 case 2).
  /// From the refund row, the reverse side of the relation is `refundFor`.
  linkedRefundId String?      @unique
  linkedRefund   Transaction? @relation("PurchaseRefund", fields: [linkedRefundId], references: [id], onDelete: SetNull)
  refundFor      Transaction? @relation("PurchaseRefund")

  /// Set on the *outgoing* leg of a transfer between two of the user's own
  /// accounts, pointing at the incoming leg (§8 case 1). From the incoming row,
  /// the reverse side of the relation is `transferPairOf`. Both legs are
  /// categorized TRANSFER and excluded from spend and income totals (§5).
  transferPairId String?      @unique
  transferPair   Transaction? @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf Transaction? @relation("TransferPair")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  splits       Split[]
  anomalyFlags AnomalyFlag[]
  overrides    CategoryOverride[]

  @@index([accountId, date])
  @@index([normalizedMerchant])
  @@index([category])
  @@index([date])
}

/// A single charge divided across categories, e.g. a big-box order mixing
/// groceries and electronics (§8 case 3). Split amounts sum to the parent amount.
model Split {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  category Category
  amount   Decimal  @db.Decimal(12, 2)
  note     String?

  createdAt DateTime @default(now())

  @@index([transactionId])
}

/// Deterministic categorization rules. A null `userId` is a built-in rule that
/// applies to everyone; a non-null one was learned from that user's override.
/// Every time a person overrides a category, recorded before the change is made.
///
/// The rule engine and the LLM both write categories; a person writing one is
/// the only signal that says the automatic answer was wrong. Keeping the old
/// value alongside the new one is what makes that measurable — "how often is
/// the engine corrected, and on what" is a question about this table.
model CategoryOverride {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// The merchant key at the time of the override, so the record survives a
  /// later re-normalization of the transaction.
  merchant String

  fromCategory Category
  toCategory   Category
  /// Whether the correction also taught a rule for the merchant.
  learnedRule  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
}

model Rule {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pattern             String
  category            Category
  /// Lower numbers win. Learned overrides are seeded below the built-ins.
  priority            Int      @default(100)
  learnedFromOverride Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pattern])
}

/// Memoizes every LLM categorization decision so the same merchant is never
/// sent to the model twice (PROJECT_CONTEXT.md §7).
model MerchantCategoryCache {
  normalizedMerchant String   @id
  category           Category
  confidence         Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
}

model AnomalyFlag {
  id String @id @default(cuid())

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     AnomalyType
  severity AnomalySeverity
  /// Calendar month the flag belongs to, as "YYYY-MM".
  month    String
  explanation String

  /// Stable identity for the underlying finding, e.g. "UNUSUAL_AMOUNT:<txn id>".
  /// Detection is idempotent: re-running it upserts on this rather than
  /// producing a second copy of a flag the user has already seen.
  fingerprint String

  /// Set when the user dismisses the flag. Dismissals are kept rather than
  /// deleted so a later detection pass cannot resurrect them.
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, month])
  @@index([transactionId])
  @@index([type])
}

model MonthlySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM".
  month   String
  content String
  /// The pre-computed aggregates the summary was generated from, wrapped with a
  /// note of how it was produced: `{ stats, generation }`. Kept so the text can
  /// be checked against the numbers it claims (PROJECT_CONTEXT.md §7), and so a
  /// later import that moves those numbers can be spotted as stale.
  statsSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}
