VITE_API_BASE_URL=http://localhost:4000

# Google Sign-In (Phase 16). The same OAuth 2.0 client ID the server verifies
# against — a client ID is public by design: it names the app to Google and
# authorises nothing on its own. Leave unset and the Google buttons do not
# render, so a build without it is a normal build rather than a broken one.
VITE_GOOGLE_CLIENT_ID=
